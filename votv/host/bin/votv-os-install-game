#!/bin/bash
# Install a Voices of the Void build into /.VotV/<version>/ and make it the current one
# (/.VotV/current), with shimloader (UE4SS) next to the game binary. Older versions stay
# until `--prune`.
#   votv-os-install-game [--root DIR] [--version V] ARCHIVE_OR_FOLDER
#   votv-os-install-game [--root DIR] --shimloader-only
#   votv-os-install-game [--root DIR] --prune      keep only the current version
set -euo pipefail

ROOT=/
VERSION=""
SHIM_ONLY=0
PRUNE=0
while [ $# -gt 0 ]; do
    case "$1" in
        --root) ROOT="$2"; shift 2 ;;
        --version) VERSION="$2"; shift 2 ;;
        --owner) shift 2 ;;   # accepted for compatibility; the game belongs to votv
        --shimloader-only) SHIM_ONLY=1; shift ;;
        --prune) PRUNE=1; shift ;;
        *) break ;;
    esac
done
R="${ROOT%/}"
VR="$R/.VotV"
SHIM="$R/usr/lib/votv-os/shimloader"
own() {   # the game belongs to the votv system user (it runs the game; UE4SS logs next to it)
    local ids
    ids=$(awk -F: '$1=="votv"{print $3":"$4}' "$R/etc/passwd" 2>/dev/null || true)
    [ -n "$ids" ] && chown -R "$ids" "$1"
    return 0
}

add_shim() {   # $1: game version dir
    local win64
    win64=$(dirname "$(find "$1" -type f -iname 'VotV-Win64-Shipping.exe' -print -quit)")
    if [ -f "$SHIM/dwmapi.dll" ]; then
        cp -f "$SHIM/dwmapi.dll" "$win64/"
        [ -f "$SHIM/UE4SS.dll" ] && cp -f "$SHIM/UE4SS.dll" "$win64/"
        [ -f "$win64/UE4SS-settings.ini" ] || { [ -f "$SHIM/UE4SS-settings.ini" ] && cp -f "$SHIM/UE4SS-settings.ini" "$win64/"; }
        [ -f "$win64/UE4SS-settings.ini" ] &&
            sed -i 's/^\(GuiConsoleEnabled\|GuiConsoleVisible\|ConsoleEnabled\) *= *1/\1 = 0/' "$win64/UE4SS-settings.ini"
    else
        echo "warning: shimloader is not staged in $SHIM; run votv-os-fetch-deps $SHIM" >&2
    fi
}

if [ "$PRUNE" = 1 ]; then
    cur=$(readlink "$VR/current" || true)
    for d in "$VR"/*/; do
        d=${d%/}; n=$(basename "$d")
        case "$n" in saves|config|r2modman|current|"$cur") continue ;; esac
        [ -f "$d/.votv-version" ] && { echo "removing $n"; rm -rf "$d"; }
    done
    exit 0
fi
if [ "$SHIM_ONLY" = 1 ]; then
    add_shim "$VR/current/"
    exit 0
fi

SRC="${1:?usage: votv-os-install-game [--root DIR] [--version V] ARCHIVE_OR_FOLDER}"
[ -e "$SRC" ] || { echo "not found: $SRC" >&2; exit 1; }
if [ -z "$VERSION" ]; then
    VERSION=$(basename "$SRC" | grep -oiE '[0-9]+\.[0-9]+\.[0-9]+[a-z]?' | head -n1 || true)
    VERSION=${VERSION:-unknown}
fi
[[ $VERSION =~ ^[A-Za-z0-9._-]+$ ]] || { echo "bad version '$VERSION'" >&2; exit 1; }
mkdir -p "$VR"
tmp=$(mktemp -d "$VR/.install.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

echo "Unpacking $SRC ..."
if [ -d "$SRC" ]; then
    cp -a "$SRC"/. "$tmp/"
else
    # By its contents, not its name: itch.io builds come as .zip, .7z or .rar.
    magic=$(head -c 6 "$SRC" | od -An -tx1 | tr -d ' \n')
    case "$magic" in
        504b0304*) unzip -q "$SRC" -d "$tmp" || 7z x -y -bd -o"$tmp" "$SRC" >/dev/null ;;
        377abcaf271c*|52617221*) 7z x -y -bd -o"$tmp" "$SRC" >/dev/null ;;
        *) case "${SRC,,}" in
               *.tar.*|*.tar|*.tgz) tar -xf "$SRC" -C "$tmp" ;;
               *) 7z x -y -bd -o"$tmp" "$SRC" >/dev/null || bsdtar -xf "$SRC" -C "$tmp" ;;
           esac ;;
    esac
fi

exe=$(find "$tmp" -type f -iname 'VotV-Win64-Shipping.exe' -print -quit)
[ -n "$exe" ] || { echo "this does not look like Voices of the Void (no VotV-Win64-Shipping.exe)" >&2; exit 1; }
# The game root is three levels above the binary: <root>/VotV/Binaries/Win64/<exe>.
game_root=$(dirname "$(dirname "$(dirname "$(dirname "$exe")")")")

DEST="$VR/$VERSION"
rm -rf "$DEST.new"
mv "$game_root" "$DEST.new"
echo "$VERSION" > "$DEST.new/.votv-version"
add_shim "$DEST.new"
rm -rf "$DEST.old"
[ -e "$DEST" ] && mv "$DEST" "$DEST.old"
mv "$DEST.new" "$DEST"
rm -rf "$DEST.old"
own "$DEST"
ln -sfn "$VERSION" "$VR/current"
echo "Voices of the Void $VERSION installed in ${DEST#"$R"} (current)"
