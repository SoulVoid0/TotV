#!/bin/bash
# GE-Proton for Voices of the Void, installed system-wide in /usr/share/totv/proton/
# (/usr/share/totv/proton/current -> the version in use). The game runs with it in a
# prefix of its own (see votv-os-launch-game); LSIW keeps its own runners for people's
# own programs. It belongs to the game's user, votv: Proton builds its default prefix and
# takes its lock (dist.lock) inside its own folder.
#
#   votv-os-proton install [--root R]   the latest GE-Proton release (SHA-512 checked)
#   votv-os-proton update [--check]     a newer release, if there is one
#   votv-os-proton path                 the folder of the version in use
set -euo pipefail

cmd="${1:-}"; shift || true
ROOT=/
[ "${1:-}" = --root ] && { ROOT="$2"; shift 2; }
R="${ROOT%/}"
TOP="$R/usr/share/totv/proton"
REPO="${GE_PROTON_REPO:-GloriousEggroll/proton-ge-custom}"

latest_json() { curl -fsSL --retry 3 -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/$REPO/releases/latest"; }
current() { basename "$(readlink "$TOP/current" 2>/dev/null || echo none)"; }
own() {
    local ids
    ids=$(awk -F: '$1=="votv"{print $3":"$4}' "$R/etc/passwd" 2>/dev/null || true)
    [ -n "$ids" ] && chown -R "$ids" "$@"
    return 0
}

install_ge() {
    local json tag tar sum tmp
    json=$(latest_json)
    tag=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["tag_name"])' <<<"$json")
    read -r tar sum < <(python3 -c '
import json, sys
a = {x["name"]: x["browser_download_url"] for x in json.load(sys.stdin)["assets"]}
# The x86-64 build: releases also carry an ARM (aarch64) one, which this PC cannot run.
def ok(n):
    l = n.lower()
    return not any(w in l for w in ("aarch64", "arm64", "armhf", "riscv"))
tars = [n for n in a if n.endswith(".tar.gz") and ok(n)]
tars.sort(key=lambda n: ("x86_64" not in n and "amd64" not in n, n))
if not tars:
    sys.exit("no x86-64 GE-Proton build in the latest release")
t = tars[0]
s = t[:-len(".tar.gz")] + ".sha512sum"
print(a[t], a.get(s, "-"))' <<<"$json")
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN
    echo "downloading $tag"
    curl -fL --retry 3 -o "$tmp/ge.tar.gz" "$tar"
    if [ "$sum" != "-" ]; then
        curl -fsSL --retry 3 -o "$tmp/ge.sha512sum" "$sum"
        [ "$(sha512sum "$tmp/ge.tar.gz" | cut -d' ' -f1)" = "$(cut -d' ' -f1 "$tmp/ge.sha512sum")" ] \
            || { echo "GE-Proton download is damaged (SHA-512 mismatch)" >&2; return 1; }
        echo "checksum verified (SHA-512)"
    fi
    mkdir -p "$TOP"
    rm -rf "${TOP:?}/$tag.new"
    mkdir -p "$TOP/$tag.new"
    tar -xzf "$tmp/ge.tar.gz" -C "$TOP/$tag.new" --strip-components=1
    [ -x "$TOP/$tag.new/proton" ] || { echo "no proton script in the download" >&2; return 1; }
    # Only a build this machine can run (the release also has an ARM one).
    if ! file -L "$TOP/$tag.new/files/bin/wine" | grep -q -e 'x86-64' -e 'x86_64'; then
        echo "the downloaded GE-Proton is not an x86-64 build: $(file -L "$TOP/$tag.new/files/bin/wine")" >&2
        rm -rf "${TOP:?}/$tag.new"; return 1
    fi
    rm -rf "${TOP:?}/$tag"
    mv "$TOP/$tag.new" "$TOP/$tag"
    old=$(current)
    ln -sfn "$tag" "$TOP/current"
    own "$TOP"
    [ "$old" != none ] && [ "$old" != "$tag" ] && rm -rf "${TOP:?}/$old"
    echo "GE-Proton $tag installed in ${TOP#"$R"}/$tag"
}

case "$cmd" in
    install) install_ge ;;
    update)
        new=$(latest_json | python3 -c 'import json,sys; print(json.load(sys.stdin)["tag_name"])') \
            || { echo "GE-Proton: cannot check for updates"; exit 0; }
        cur=$(current)
        if [ "$new" != "$cur" ]; then
            [ "${1:-}" = --check ] && { echo "GE-Proton: $cur -> $new available"; exit 100; }
            install_ge
        else
            echo "GE-Proton $cur is the newest"
        fi ;;
    path) readlink -f "$TOP/current" ;;
    fix-owner) own "$TOP" ;;
    *) sed -n '2,10s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
