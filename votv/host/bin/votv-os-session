#!/bin/bash
# The TotV shell: KWin (Wayland) on the real screens, as the votv system user, started by
# totv-shell.service on tty1 at boot. The votv-os-wm KWin script places the game, the
# in-game PC (the login screen, or the logged-in user's KDE desktop) and the
# second-screen inventory. Its Wayland socket is /run/totv/shell/wayland-0, open to the
# votv group, so the users' PC desktops (totv-desktop@.service) show up in it.
set -u

SHELL_DIR="${TOTV_SHELL_DIR:-/run/totv/shell}"
RT="${VOTV_OS_RUNTIME_LINUX:-/run/totv/votv-os}"
mkdir -p "$RT/frames" "$SHELL_DIR/pulse"
LOG="$RT/session.log"
exec >>"$LOG" 2>&1
echo "== votv-os-session $(date -Is) as $(id -un)"

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=KDE
export XDG_SESSION_DESKTOP=totv
export KDE_SESSION_VERSION=6
export QT_QPA_PLATFORM=wayland
export TOTV_SHELL_WAYLAND="$SHELL_DIR/wayland-0"

if command -v kwriteconfig6 >/dev/null; then
    kwriteconfig6 --file kwinrc --group Plugins --key votv-os-wmEnabled true
    # No screen edges / overview gestures over the game, no screen locking.
    kwriteconfig6 --file kwinrc --group Effect-overview --key BorderActivate 9
    kwriteconfig6 --file kwinrc --group ElectricBorders --key TopLeft None
    kwriteconfig6 --file kscreenlockerrc --group Daemon --key Autolock false
fi

exec dbus-run-session -- votv-wayland-socket "$TOTV_SHELL_WAYLAND" 0660 -- \
    kwin_wayland --xwayland --no-lockscreen \
    --exit-with-session=/usr/lib/votv-os/votv-os-session-main
