#!/usr/bin/python3
"""votv-os-game: Voices of the Void as a part of TotV OS.

  votv-os-game status                 the installed versions and the current one
  votv-os-game latest                 the newest build on itch.io (mrdrnose.itch.io/votv)
  votv-os-game fetch DIR [--version V] download a build (zip) into DIR, print its path
  votv-os-game install [--version V] [--root R]
                                      download and install it into /.VotV/<version>
  votv-os-game update [--check]       install the newest build if it is newer than the
                                      current one (exit 100 with --check when it is)

Downloads use itch.io's own download flow for free games; with ITCH_API_KEY set (an
itch.io API key) the official API is used instead. VOTV_URL=<url of a zip> skips itch.io.
"""
import html
import http.cookiejar
import json
import os
import re
import subprocess
import sys
import urllib.parse
import urllib.request
from pathlib import Path

PAGE = os.environ.get("VOTV_ITCH_PAGE", "https://mrdrnose.itch.io/votv")
ROOT = Path(os.environ.get("VOTV_ROOT", "/.VotV"))
UA = "TotV-OS (votv-os-game)"
# Builds are named like "[RECENT] Alpha 0.9.0-n", "votv_0.9.0n.zip", "0.10.0_2 early preview".
VER_RE = re.compile(r"(\d+)\.(\d+)\.(\d+)(?:[-_ ]?([a-z]|\d+)\b)?", re.I)


def find_version(*texts):
    """The build's version, normalised: 0.9.0-n -> 0.9.0n, 0.10.0_2 -> 0.10.0_2."""
    for t in texts:
        m = VER_RE.search(t or "")
        if m:
            suffix = m[4] or ""
            if suffix.isdigit():
                suffix = "_" + suffix
            return f"{m[1]}.{m[2]}.{m[3]}{suffix.lower()}"
    return ""

jar = http.cookiejar.CookieJar()
opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(jar))


def get(url, data=None, headers=None):
    h = {"User-Agent": UA, **(headers or {})}
    if data is not None and not isinstance(data, bytes):
        data = urllib.parse.urlencode(data).encode()
    req = urllib.request.Request(url, data=data, headers=h)
    with opener.open(req, timeout=60) as r:
        return r.read()


def version_key(v):
    m = re.match(r"(\d+)\.(\d+)\.(\d+)([a-z]?)(?:_(\d+))?", v or "", re.I)
    if not m:
        return (-1,)
    return (int(m[1]), int(m[2]), int(m[3]), m[4].lower(), int(m[5] or 0))


def uploads():
    """[(version, filename, upload_id, download_fn)] for the Windows builds."""
    key = os.environ.get("ITCH_API_KEY")
    game = json.loads(get(PAGE.rstrip("/") + "/data.json"))
    gid = game["id"]
    out = []
    if key:
        auth = {"Authorization": f"Bearer {key}"}
        d = json.loads(get(f"https://api.itch.io/games/{gid}/uploads", headers=auth))
        for u in d.get("uploads", []):
            if "windows" not in (u.get("traits") or []) and not u.get("p_windows"):
                continue
            name = u.get("filename") or u.get("display_name") or ""
            uid = u["id"]
            out.append((find_version(u.get("display_name"), name), name, uid,
                        lambda uid=uid: json.loads(get(f"https://api.itch.io/uploads/{uid}/download", headers=auth)).get("url")
                        or f"https://api.itch.io/uploads/{uid}/download?api_key={key}"))
        return out
    # The page's own flow for free / name-your-own-price games.
    page = get(PAGE).decode("utf-8", "replace")
    csrf = re.search(r'name="csrf_token"\s+value="([^"]+)"', page) or re.search(r'csrf_token"\s*content="([^"]+)"', page)
    r = json.loads(get(PAGE.rstrip("/") + "/download_url", {"csrf_token": csrf[1] if csrf else ""},
                       {"Referer": PAGE, "X-Requested-With": "XMLHttpRequest"}))
    dl_page = get(r["url"]).decode("utf-8", "replace")
    dl_key = r["url"].rstrip("/").rsplit("/", 1)[-1]
    csrf2 = (re.search(r'name="csrf_token"\s+value="([^"]+)"', dl_page) or re.search(r'csrf_token"\s*content="([^"]+)"', dl_page)
             or re.search(r'"csrf_token"\s*:\s*"([^"]+)"', dl_page) or csrf)
    # One <div class="upload"> per file: <strong class="name" title="FILE">DISPLAY NAME</strong>,
    # platform icons, and a download button with data-upload_id.
    for block in re.split(r'<div[^>]*class="upload"', dl_page)[1:]:
        uid = re.search(r'data-upload_id="(\d+)"', block)
        if not uid:
            continue
        strong = re.search(r'<strong([^>]*)>(.*?)</strong>', block, re.S)
        attrs = strong[1] if strong else ""
        title = re.search(r'title="([^"]*)"', attrs)
        filename = html.unescape(title[1]) if title else ""
        display = html.unescape(re.sub(r"<[^>]+>", "", strong[2])).strip() if strong else ""
        if "icon-windows" not in block and not filename.lower().endswith((".zip", ".7z", ".rar")):
            continue
        name = filename or display
        v = find_version(display, filename)

        def fn(uid=uid[1]):
            # The download page's button, then the game page's direct download (free games).
            tries = [({"source": "game_download", "key": dl_key}, csrf2, r["url"]),
                     ({"source": "view_game", "as_props": "1", "after_download_lightbox": "true"}, csrf, PAGE)]
            last = None
            for params, tok, ref in tries:
                try:
                    d = json.loads(get(f"{PAGE.rstrip('/')}/file/{uid}?{urllib.parse.urlencode(params)}",
                                       {"csrf_token": tok[1] if tok else ""},
                                       {"Referer": ref, "X-Requested-With": "XMLHttpRequest"}))
                except (OSError, ValueError) as e:
                    d = {"error": str(e)}
                if isinstance(d, dict) and d.get("url"):
                    return d["url"]
                last = d
                print(f"votv-os-game: itch.io answered {params['source']}: {json.dumps(d)[:300]}", file=sys.stderr)
            raise SystemExit(f"votv-os-game: itch.io gave no download link ({json.dumps(last)[:200]}); "
                             "set ITCH_API_KEY (an itch.io API key) or VOTV_URL (a direct link to the zip)")
        out.append((v, name, uid[1], fn))
    return out


def latest(version=None, stable=True):
    found = uploads()
    print("builds on itch.io: " + ", ".join(f"{v or '?'} ({n})" for v, n, _u, _f in found), file=sys.stderr)
    ups = [u for u in found if u[0]]
    if version:
        want = find_version(version) or version
        hit = [u for u in ups if u[0].lower() == want.lower()]
        if hit:
            return hit[0]
        print(f"votv-os-game: build {version} is not on itch.io any more; using the newest", file=sys.stderr)
    if stable:   # previews ("0.10.0_2 early preview") only when nothing else is there
        st = [u for u in ups if "_" not in u[0] and "preview" not in u[1].lower()]
        ups = st or ups
    if not ups:
        raise SystemExit("votv-os-game: no Windows build found on " + PAGE)
    return max(ups, key=lambda u: version_key(u[0]))


def fetch(dest, version=None):
    dest = Path(dest)
    dest.mkdir(parents=True, exist_ok=True)
    url = os.environ.get("VOTV_URL")
    if url:
        name = os.path.basename(urllib.parse.urlparse(url).path) or f"votv-{version or 'unknown'}.zip"
    else:
        v, name, _uid, fn = latest(version)
        url = fn()
        ext = os.path.splitext(name)[1].lower()
        name = f"votv-{v}{ext if ext in ('.zip', '.7z', '.rar') else '.zip'}"
    out = dest / name
    print(f"downloading {name} ...", file=sys.stderr)
    subprocess.run(["curl", "-fL", "--retry", "3", "-A", UA, "-o", str(out), url], check=True)
    return out


def current():
    try:
        return os.readlink(ROOT / "current")
    except OSError:
        return None


def install(version=None, root="/"):
    work = Path(root) / ".VotV" / ".download"
    try:
        z = fetch(work, version)
        v = find_version(z.name)
        subprocess.run(["votv-os-install-game", "--root", root] + (["--version", v] if v else []) + [str(z)],
                       check=True)
    finally:
        subprocess.run(["rm", "-rf", str(work)])


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd, rest = argv[0], argv[1:]
    opt = {}
    i = 0
    pos = []
    while i < len(rest):
        if rest[i] in ("--version", "--root"):
            opt[rest[i][2:]] = rest[i + 1]
            i += 2
        else:
            pos.append(rest[i])
            i += 1
    if cmd == "status":
        print("current:", current() or "none")
        for d in sorted(ROOT.glob("*/.votv-version")):
            print("installed:", d.parent.name)
        return 0
    if cmd == "latest":
        v, name, _u, _f = latest()
        print(v, name)
        return 0
    if cmd == "fetch" and pos:
        print(fetch(pos[0], opt.get("version")))
        return 0
    if cmd == "install":
        install(opt.get("version"), opt.get("root", "/"))
        return 0
    if cmd == "update":
        try:
            v = latest()[0]
        except Exception as e:   # no network, itch.io changed: not fatal for an OS update
            print(f"votv-os-game: cannot check for a new build: {e}", file=sys.stderr)
            return 0
        cur = current()
        newer = version_key(v) > version_key(cur or "")
        print(f"Voices of the Void: installed {cur or 'none'}, newest {v}{' (update available)' if newer else ''}")
        if "--check" in pos:
            return 100 if newer else 0
        if newer:
            install(v)
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
