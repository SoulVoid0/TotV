#!/bin/bash
# Inside the TotV shell compositor (as votv): the bridge, the login screen (the in-game
# PC while nobody is logged in), the second-screen inventory, and the game, which is
# kept running: a crash restarts it, and so does `votv-os-ctl restart-game` (r2modman's
# "Start modded" does that, so mod changes apply).
set -u

RT="${VOTV_OS_RUNTIME_LINUX:-/run/totv/votv-os}"
export WAYLAND_DISPLAY="${TOTV_SHELL_WAYLAND:-/run/totv/shell/wayland-0}"
mkdir -p "$RT/frames"
PY="${VOTV_OS_PYTHON:-/usr/lib/votv-os/python}"

python3 -c "import sys; sys.path.insert(0, '$PY'); from votvos.ipc import reset_session; reset_session()"
rm -f "$RT/restart-game"
# Mods changed in VotV Mods are applied by this (re)start.
rm -f /.VotV/r2modman/r2modmanPlus-local/VotV/profiles/*/totv-pending.json

children=()
start() { "$@" & children+=("$!"); }
cleanup() {
    for pid in "${children[@]}"; do kill "$pid" 2>/dev/null; done
    [ -n "${game:-}" ] && kill "$game" 2>/dev/null
    wait
}
trap cleanup EXIT

dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE DISPLAY 2>/dev/null

start votv-os-bridge
for _ in $(seq 50); do [ -s "$RT/screens.json" ] && break; sleep 0.1; done
start votv-login
start votv-inventory

# The game. Three crashes within two minutes stop the restarts (a broken install), and
# a dialog says why; `votv-os-ctl restart-game` starts it again.
fails=()
while :; do
    started=$(date +%s)
    # The game's own output (Wine/Proton, LSIW) in a log of its own, newest start last.
    echo "== game start $(date -Is)" >>"$RT/game.log"
    votv-os-launch-game >>"$RT/game.log" 2>&1 &
    game=$!
    while kill -0 "$game" 2>/dev/null; do
        if [ -e "$RT/restart-game" ]; then
            rm -f "$RT/restart-game"
# Mods changed in VotV Mods are applied by this (re)start.
rm -f /.VotV/r2modman/r2modmanPlus-local/VotV/profiles/*/totv-pending.json
            echo "restart requested"
            pkill -TERM -P "$game" 2>/dev/null; kill -TERM "$game" 2>/dev/null
            pkill -TERM -u "$(id -u)" -f 'VotV-Win64-Shipping' 2>/dev/null || true
            fails=()
        fi
        sleep 1
    done
    wait "$game"; code=$?
    game=
    [ -e "$RT/exit-session" ] && { rm -f "$RT/exit-session"; break; }
    now=$(date +%s)
    [ "$code" -ne 0 ] && fails+=("$now")
    recent=0
    for t in "${fails[@]}"; do [ $((now - t)) -lt 120 ] && recent=$((recent + 1)); done
    echo "game exited with $code after $((now - started))s ($recent recent failures)"
    if [ "$recent" -ge 3 ]; then
        last=$(grep -v -e '^qml:' -e '^$' "$RT/game.log" | tail -n 25)
        command -v kdialog >/dev/null && kdialog --title "Voices of the Void" --error "Voices of the Void stopped three times in two minutes.

Last lines of $RT/game.log:

$last

It starts again with Restart Voices of the Void (on the desktop) or r2modman's Start modded." &
        until [ -e "$RT/restart-game" ]; do sleep 2; done
        rm -f "$RT/restart-game"
# Mods changed in VotV Mods are applied by this (re)start.
rm -f /.VotV/r2modman/r2modmanPlus-local/VotV/profiles/*/totv-pending.json
        fails=()
    fi
    sleep 2
done
