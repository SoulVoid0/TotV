#!/usr/bin/env bash
# totv-install: set up TotV and install it on a disk (an internal disk or a
# USB stick), from the TotV installer live system.
#
#   totv-install                   interactive (dialog)
#   totv-install --answers FILE    unattended; FILE holds KEY=value lines:
#       DISK=/dev/sdX  HOSTNAME=totv  USERNAME=name  USER_PASSWORD=...
#       ROOT_PASSWORD=... (empty: root locked, use sudo)
#       TIMEZONE=UTC  LOCALE=en_US.UTF-8  KEYMAP=us  AUTOLOGIN=no
#       SOURCE=auto|image|packages  IMAGE=/path/to/totv-system-*.iso[.parts]
#       IMAGE_URL=https://.../download/vX.Y.Z  (where the image parts are)
#       GAME_ARCHIVE=/path (packages source only)  CONFIRM_WIPE=yes
#       REBOOT=no  KERNEL_CMDLINE="console=ttyS0" (extra kernel parameters)
#
# What it does: one GPT disk layout that boots on BIOS and UEFI computers
# (1 MiB BIOS boot, 1 GiB EFI system partition mounted at /boot, ext4 root),
# then the system itself, from one of:
#   image     the TotV system image (totv-system-<version>-x86_64.iso): the whole OS
#             with Voices of the Void in /.VotV and r2modman. It is bigger than 2 GiB,
#             so releases carry it in parts (.part00, .part01, ... and a .parts index);
#             the installer finds the image or its parts on any drive (a second USB
#             stick, the TOTV_DATA partition tools/write-usb.sh adds to the installer
#             stick) or downloads the parts of this version from GitHub, checks each
#             part's SHA-256, merges them on the target disk, checks the whole image
#             and unpacks it;
#   packages  (no image) the packages of /etc/totv/target-packages and votv-os, from
#             the installer's repository and the Arch mirrors, then the game and
#             r2modman downloaded.
# Then the user, locale and clock, GRUB as a removable-media bootloader (so the disk
# also boots on other computers), and /etc/totv/{totv,user}.conf.
#
# SPDX-License-Identifier: MIT
set -Eeuo pipefail

readonly TARGET=/mnt
readonly REPO=/opt/totv/repo
readonly CONF=/etc/totv
readonly LOG=/var/log/totv-install.log
readonly MIN_DISK_BYTES=$((32 * 1024 * 1024 * 1024))
readonly MEDIA=/run/totv-media
readonly RELEASES=https://github.com/SoulVoid0/TotV/releases
TOTV_VERSION=unknown
[[ -r /etc/totv-live-release ]] && . /etc/totv-live-release
readonly TOTV_VERSION
readonly TITLE="TotV ${TOTV_VERSION} installer"

DISK='' HOSTNAME_='' USERNAME='' USER_PASSWORD='' ROOT_PASSWORD=''
TIMEZONE=UTC LOCALE=en_US.UTF-8 KEYMAP=us AUTOLOGIN=no OPTIONS=''
GAME_ARCHIVE='' CONFIRM_WIPE='' REBOOT='' KERNEL_CMDLINE='' OFFLINE=0 INTERACTIVE=1
SOURCE=auto IMAGE='' IMAGE_URL='' IMAGE_KIND=''

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
log() { printf '[%(%H:%M:%S)T] %s\n' -1 "$*" >>"$LOG"; }
die() {
    log "ERROR: $*"
    if ((INTERACTIVE)); then
        # The end of the log says why; dialog's own screen is the terminal, not the step's log.
        local tailtxt
        tailtxt=$(grep -v -e '^progress ' -e '^\[' "$LOG" 2>/dev/null | tail -n 12 | cut -c1-110 | sed 's/\\/\\\\/g')
        dialog --backtitle "$TITLE" --title "Installation failed" \
            --msgbox "$*\n\nLast lines of $LOG:\n\n$tailtxt\n\nAlt+F2 opens a shell (user root, no password)." 24 116 </dev/null >/dev/tty 2>&1 || true
        clear >/dev/tty 2>&1 || true
    fi
    echo "totv-install: $*" >&2
    exit 1
}
trap 'die "command failed (line $LINENO): $BASH_COMMAND"' ERR

# dialog writes the answer to stderr; this returns it on stdout.
ask() { dialog --backtitle "$TITLE" "$@" 3>&1 1>&2 2>&3; }

# Partition N of DISK: /dev/sda3, /dev/nvme0n1p3, /dev/mmcblk0p3.
part() { if [[ $1 =~ [0-9]$ ]]; then echo "${1}p$2"; else echo "$1$2"; fi; }

# Runs a step, showing it in a progress box when interactive.
STEP_NO=0 STEP_TOTAL=12
step() {
    local msg=$1; shift
    STEP_NO=$((STEP_NO + 1))
    log "== $msg"
    if ((INTERACTIVE)); then
        dialog --backtitle "$TITLE" --title "Installing" \
            --gauge "$msg" 8 70 $((STEP_NO * 100 / STEP_TOTAL)) </dev/null || true
    else
        echo ":: [$STEP_NO/$STEP_TOTAL] $msg"
    fi
    "$@" >>"$LOG" 2>&1
}

valid_username() {
    [[ $1 =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || return 1
    case $1 in
        root|bin|daemon|mail|ftp|http|nobody|dbus|polkitd|rtkit|uuidd|git|alpm|\
        systemd-*|avahi|colord|sddm|gdm|lightdm|cdrive|wheel|users|admin|steamuser|public|default|votv|totv)
            return 1 ;;
    esac
}
valid_hostname() { [[ $1 =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]]; }
valid_timezone() { [[ -n $1 && $1 != *..* && -f /usr/share/zoneinfo/$1 ]]; }
valid_locale() { grep -q "^${1//./\\.} " /usr/share/i18n/SUPPORTED 2>/dev/null; }
valid_keymap() {
    [[ $1 =~ ^[A-Za-z0-9_.-]+$ ]] || return 1
    [[ -n $(find /usr/share/kbd/keymaps -name "$1.map*" -print -quit 2>/dev/null) ]]
}

# The disk the live system was started from (never offered as a target).
live_disk() {
    local src
    src=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null) || return 0
    [[ -b $src ]] || return 0
    local pk; pk=$(lsblk -no PKNAME "$src" 2>/dev/null) || return 0
    pk=${pk%%$'\n'*}
    [[ -n $pk ]] && echo "/dev/$pk"
    return 0
}

# ---------------------------------------------------------------------------
# Questions
# ---------------------------------------------------------------------------
pick_disk() {
    local live items=() name size model tran rm bytes tag
    live=$(live_disk)
    while read -r name; do
        [[ -n $name && $name != "$live" ]] || continue
        [[ $(lsblk -dno TYPE "$name") == disk ]] || continue
        bytes=$(lsblk -dbno SIZE "$name")
        ((bytes >= MIN_DISK_BYTES)) || continue
        size=$(lsblk -dno SIZE "$name" | tr -d ' ')
        model=$(lsblk -dno MODEL "$name" | sed 's/ *$//')
        tran=$(lsblk -dno TRAN "$name" | tr -d ' ')
        rm=$(lsblk -dno RM "$name" | tr -d ' ')
        tag=""
        [[ $tran == usb || $rm == 1 ]] && tag=" [USB/removable]"
        items+=("$name" "$size ${model:-disk}$tag")
    done < <(lsblk -dpno NAME -e 7,11)
    ((${#items[@]})) || die "No disk of at least 32 GiB was found (the installer's own USB stick is not offered). Plug in the USB stick or disk to install TotV on and start the installer again (type: totv-install)."
    DISK=$(ask --title "Where to install TotV" --menu \
        "Choose the disk to install TotV on. EVERYTHING on it will be erased.\nA USB stick works: TotV will boot from it on any computer." \
        18 76 8 "${items[@]}") || exit 0
}

ask_username() {
    while :; do
        USERNAME=$(ask --title "Your user" --inputbox \
            "Choose your username.\n\nYou log in with it on the in-game PC, and your own Voices of the Void save is named after it.\nLowercase letters, digits, '-' and '_', starting with a letter; at most 32 characters." \
            14 70 "$USERNAME") || exit 0
        valid_username "$USERNAME" && return
        dialog --backtitle "$TITLE" --msgbox "'$USERNAME' cannot be used as a username." 7 60
    done
}

ask_password() {   # $1 = label, result in REPLY_PW; empty allowed when $2=empty-ok
    local a b
    while :; do
        a=$(ask --insecure --title "$1" --passwordbox "Password for $1:${2:+\n(leave empty to lock the root account and use sudo)}" 10 64) || exit 0
        if [[ -z $a ]]; then
            [[ ${2:-} == empty-ok ]] && { REPLY_PW=''; return; }
            dialog --backtitle "$TITLE" --msgbox "The password cannot be empty." 7 50; continue
        fi
        b=$(ask --insecure --title "$1" --passwordbox "Type the password for $1 again:" 10 64) || exit 0
        [[ $a == "$b" ]] && { REPLY_PW=$a; return; }
        dialog --backtitle "$TITLE" --msgbox "The passwords do not match." 7 50
    done
}

ask_hostname() {
    while :; do
        HOSTNAME_=$(ask --title "Computer name" --inputbox \
            "Name of this computer on the network:" 9 60 "${HOSTNAME_:-totv}") || exit 0
        valid_hostname "$HOSTNAME_" && return
        dialog --backtitle "$TITLE" --msgbox "Use letters, digits and '-' only." 7 50
    done
}

ask_timezone() {
    local regions=() r city cities=() c
    while read -r r; do regions+=("$r" ""); done < <(
        find /usr/share/zoneinfo -mindepth 1 -maxdepth 1 -type d -printf '%f\n' |
            grep -Ev '^(posix|right|Etc|SystemV|US|Brazil|Canada|Chile|Mexico)$' | sort)
    r=$(ask --title "Time zone" --menu "Region (choose UTC for none):" 20 50 12 UTC "" "${regions[@]}") || exit 0
    if [[ $r == UTC ]]; then TIMEZONE=UTC; return; fi
    while read -r c; do cities+=("$c" ""); done < <(
        cd "/usr/share/zoneinfo/$r" && find . -type f -printf '%P\n' | sort)
    city=$(ask --title "Time zone" --menu "City in $r:" 22 50 15 "${cities[@]}") || exit 0
    TIMEZONE="$r/$city"
}

ask_locale() {
    local common=(en_US.UTF-8 en_GB.UTF-8 de_DE.UTF-8 fr_FR.UTF-8 es_ES.UTF-8 it_IT.UTF-8
                  pt_BR.UTF-8 nl_NL.UTF-8 pl_PL.UTF-8 ru_RU.UTF-8 sv_SE.UTF-8 ja_JP.UTF-8)
    local items=() l
    for l in "${common[@]}"; do items+=("$l" ""); done
    items+=(other "type another")
    LOCALE=$(ask --title "Language" --default-item "$LOCALE" --menu "System language (locale):" 20 50 13 "${items[@]}") || exit 0
    if [[ $LOCALE == other ]]; then
        while :; do
            LOCALE=$(ask --inputbox "Locale (as in /usr/share/i18n/SUPPORTED, e.g. fi_FI.UTF-8):" 9 64 "en_US.UTF-8") || exit 0
            valid_locale "$LOCALE" && break
        done
    fi
}

ask_keymap() {
    while :; do
        KEYMAP=$(ask --title "Keyboard" --inputbox \
            "Console keyboard layout (us, uk, de-latin1, fr, es, it, sv-latin1, ...):" 9 64 "$KEYMAP") || exit 0
        valid_keymap "$KEYMAP" && { loadkeys "$KEYMAP" 2>/dev/null || true; return; }
        dialog --backtitle "$TITLE" --msgbox "Unknown keyboard layout '$KEYMAP'." 7 50
    done
}

ask_options() {
    local items=() name pkgs on
    while read -r name pkgs; do
        [[ -z $name || $name == \#* ]] && continue
        on=off; [[ " $OPTIONS " == *" $name "* ]] && on=on
        items+=("$name" "$pkgs" "$on")
    done <"$CONF/optional-packages"
    items+=(autologin "log in automatically after the shared Home save has loaded" "$([[ $AUTOLOGIN == yes ]] && echo on || echo off)")
    local sel
    sel=$(ask --title "Options" --separate-output --checklist \
        "Optional parts (space toggles).\nTotV always starts in the shared Home save \"default\"; you log in on the in-game PC.\nWith autologin you are moved to your own save as soon as it has loaded." \
        16 76 6 "${items[@]}") || exit 0
    OPTIONS='' AUTOLOGIN=no
    local s
    while read -r s; do
        [[ -z $s ]] && continue
        if [[ $s == autologin ]]; then AUTOLOGIN=yes; else OPTIONS+="$s "; fi
    done <<<"$sel"
    OPTIONS=${OPTIONS% }
}

# Every partition except the target's and the installer's own, mounted read-only.
mount_media() {
    local d live mp
    live=$(live_disk)
    mkdir -p "$MEDIA"
    while read -r d; do
        [[ -n $live && $d == "$live"* && $(lsblk -no LABEL "$d" 2>/dev/null) != TOTV_DATA ]] && continue
        [[ -n $DISK && $d == "$DISK"* ]] && continue
        mp="$MEDIA/${d##*/}"
        mountpoint -q "$mp" && continue
        mkdir -p "$mp"
        mount -o ro "$d" "$mp" 2>/dev/null || rmdir "$mp" 2>/dev/null || true
    done < <(lsblk -pnlo NAME,TYPE,FSTYPE | awk '($2=="part" || $2=="disk") && $3!="" && $3!="iso9660" {print $1}')
}

# The system image for this version: a whole .iso or a .parts index (with its parts
# next to it), on a drive. Sets IMAGE and IMAGE_KIND (iso|parts).
find_local_image() {
    local f best=''
    [[ -n $IMAGE ]] && { [[ $IMAGE == *.parts ]] && IMAGE_KIND=parts || IMAGE_KIND=iso; return 0; }
    mount_media
    for f in "$MEDIA"/*/totv-system-*-x86_64.iso.parts "$MEDIA"/*/*/totv-system-*-x86_64.iso.parts \
             "$MEDIA"/*/totv-system-*-x86_64.iso "$MEDIA"/*/*/totv-system-*-x86_64.iso; do
        [[ -e $f ]] || continue
        if [[ $f == *"-$TOTV_VERSION-"* ]]; then best=$f; break; fi
        [[ -z $best ]] && best=$f
    done
    [[ -n $best ]] || return 1
    IMAGE=$best
    [[ $IMAGE == *.parts ]] && IMAGE_KIND=parts || IMAGE_KIND=iso
    log "system image found: $IMAGE"
}

remote_index() {   # prints the URL of the .parts index of this version (or the latest)
    local base
    for base in "${IMAGE_URL:-}" "$RELEASES/download/v$TOTV_VERSION" "$RELEASES/latest/download"; do
        [[ -n $base ]] || continue
        local u="$base/totv-system-$TOTV_VERSION-x86_64.iso.parts"
        curl -fsSL --max-time 20 -o /dev/null "$u" 2>/dev/null && { echo "$u"; return 0; }
    done
    return 1
}

pick_sources() {
    local online=0
    curl -fsS --max-time 10 -o /dev/null https://github.com/ 2>/dev/null && online=1
    if [[ $SOURCE == auto || $SOURCE == image ]]; then
        if find_local_image; then
            SOURCE=image
        elif ((online)) && IMAGE=$(remote_index); then
            SOURCE=image IMAGE_KIND=remote
        elif [[ $SOURCE == image ]]; then
            die "The TotV system image (totv-system-$TOTV_VERSION-x86_64.iso, or its .part files with the .parts index) was not found on any drive, and it cannot be downloaded (no internet connection). Copy the image or its parts to a USB stick, plug it in, and start the installer again (type: totv-install)."
        else
            SOURCE=packages
        fi
    fi
    if [[ $SOURCE == packages ]]; then
        ((online)) || die "No TotV system image was found and there is no internet connection. Plug in a drive with the system image (totv-system-$TOTV_VERSION-x86_64.iso or its parts), or connect to the internet (Ethernet works by itself; for Wi-Fi run: iwctl), then start the installer again (type: totv-install)."
        OFFLINE=0
    fi
    [[ -e $REPO/.complete && $SOURCE == packages ]] && OFFLINE=0
    PACMAN_CONF="$CONF/pacman-online.conf"
    log "source: $SOURCE ${IMAGE_KIND:+($IMAGE_KIND: $IMAGE)}"
}

describe_source() {
    case $SOURCE/$IMAGE_KIND in
        image/iso) echo "the system image $(basename "$IMAGE")" ;;
        image/parts) echo "the system image parts next to $(basename "$IMAGE")" ;;
        image/remote) echo "the system image, downloaded from GitHub and merged" ;;
        *) echo "packages from the internet (no system image found)" ;;
    esac
}

confirm() {
    local size model
    size=$(lsblk -dno SIZE "$DISK"); model=$(lsblk -dno MODEL "$DISK")
    dialog --backtitle "$TITLE" --title "Ready to install" --defaultno --yesno \
"Disk:        $DISK ($size ${model})
             ALL DATA ON THIS DISK WILL BE ERASED
Username:    $USERNAME  (your login and your Voices of the Void save)
Computer:    $HOSTNAME_
Time zone:   $TIMEZONE
Language:    $LOCALE    Keyboard: $KEYMAP
Autologin:   $AUTOLOGIN
Installs:    $(describe_source)
             (Voices of the Void and r2modman are part of the system)

Erase $DISK and install TotV?" 20 76
}

# ---------------------------------------------------------------------------
# Installation
# ---------------------------------------------------------------------------
target_packages() {
    sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$CONF/target-packages"
    local name pkgs opt
    while read -r name pkgs; do
        [[ -z $name || $name == \#* ]] && continue
        for opt in $OPTIONS; do [[ $opt == "$name" ]] && tr ' ' '\n' <<<"$pkgs"; done
    done <"$CONF/optional-packages"
    [[ -r $CONF/votv-packages ]] && sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$CONF/votv-packages"
    echo votv-os
    return 0
}

do_cleanup_target() {
    swapoff -a 2>/dev/null || true
    umount -R "$TARGET" 2>/dev/null || true
    local p
    for p in $(lsblk -lnpo NAME "$DISK" | tail -n +2); do umount "$p" 2>/dev/null || true; done
}

do_partition() {
    wipefs -af "$DISK"
    sgdisk --zap-all "$DISK"
    sgdisk -n1:0:+1M   -t1:ef02 -c1:"BIOS boot" \
           -n2:0:+1G   -t2:ef00 -c2:"TOTV_EFI" \
           -n3:0:0     -t3:8304 -c3:"TOTV_ROOT" "$DISK"
    partprobe "$DISK" || true
    udevadm settle
    sleep 1
}

do_format() {
    mkfs.fat -F 32 -n TOTV_EFI "$(part "$DISK" 2)"
    mkfs.ext4 -F -L TOTV_ROOT "$(part "$DISK" 3)"
}

do_mount() {
    mount "$(part "$DISK" 3)" "$TARGET"
    mount --mkdir -o fmask=0077,dmask=0077 "$(part "$DISK" 2)" "$TARGET/boot"
}

# The system image: merged (when in parts) into a file on the target disk, checked,
# and unpacked into the target root.
# Progress of the long phases, on the installer's screen (the step's output goes to the log).
show() {   # MESSAGE PERCENT
    log "progress $2%: ${1//$'\n'/ }"
    ((INTERACTIVE)) || return 0
    dialog --backtitle "$TITLE" --title "Installing the system" --gauge "$1" 11 74 "$2" </dev/null >/dev/tty 2>&1 || true
}
mib() { echo $(($1 / 1048576)); }

# Waits for PID, showing DONE_CMD's output (bytes done) against TOTAL between LO% and HI%.
track() {   # PID TOTAL LO HI MESSAGE DONE_CMD...
    local pid=$1 total=$2 lo=$3 hi=$4 msg=$5 done_b; shift 5
    while kill -0 "$pid" 2>/dev/null; do
        done_b=$("$@" 2>/dev/null || echo 0)
        ((done_b > total)) && done_b=$total
        show "$msg\n\n$(mib "$done_b") of $(mib "$total") MiB" $((lo + (hi - lo) * done_b / (total > 0 ? total : 1)))
        sleep 2
    done
    wait "$pid"
}
size_of() { stat -c %s "$1" 2>/dev/null || echo 0; }

# Bytes a process has read so far from a list of files it reads in order (sha256sum of the parts).
read_pos() {   # PID FILE...
    local pid=$1 f fd pos=0 target; shift
    for fd in /proc/"$pid"/fd/*; do
        target=$(readlink "$fd" 2>/dev/null) || continue
        for f in "$@"; do
            [[ $target == "$f" ]] || continue
            pos=$(awk '/^pos:/ {print $2}' "/proc/$pid/fdinfo/${fd##*/}" 2>/dev/null || echo 0)
            local before=0 g
            for g in "$@"; do [[ $g == "$f" ]] && break; before=$((before + $(size_of "$g"))); done
            echo $((before + pos)); return 0
        done
    done
    echo 0
}

# The system image: its parts are downloaded (or found on a drive), checked, and joined
# without copying (a read-only device-mapper device over the parts; a merged file only if
# that is unavailable). Prints the path of the image (a file or a block device).
fetch_image() {
    local dir="$TARGET/.totv-image" idx base kind size sum name
    mkdir -p "$dir"
    if [[ $IMAGE_KIND == iso ]]; then
        echo "$IMAGE"; return 0
    fi
    if [[ $IMAGE_KIND == remote ]]; then
        curl -fsSL --retry 3 -o "$dir/index" "$IMAGE"
        base=${IMAGE%/*}
    else
        cp "$IMAGE" "$dir/index"
        base=$(dirname "$IMAGE")
    fi
    idx="$dir/index"
    local whole_name whole_size whole_sum
    read -r kind whole_size whole_sum whole_name < <(grep '^image ' "$idx")
    [[ $kind == image && -n $whole_name ]] || die "the image index $IMAGE is not valid"
    local parts=() sizes=() sums=() total n=0 got=0
    total=$(grep -c '^part ' "$idx")
    while read -r kind size sum name; do
        [[ $kind == part ]] || continue
        [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || die "bad part name in the index: $name"
        n=$((n + 1))
        local src="$base/$name"
        if [[ $IMAGE_KIND == remote ]]; then
            src="$dir/$name"
            if [[ $(size_of "$src") != "$size" ]]; then
                log "downloading part $n/$total: $name"
                curl -fsL --retry 5 --retry-delay 5 -C - -o "$src" "$base/$name" >>"$LOG" 2>&1 &
                track $! "$whole_size" 0 50 "Downloading the TotV system image (part $n of $total)" \
                    bash -c 'echo $(( $1 + $(stat -c %s "$2" 2>/dev/null || echo 0) ))' _ "$got" "$src" \
                    || die "downloading $name failed; check the internet connection and start the installer again"
            fi
        fi
        [[ -r $src ]] || die "part $name of the system image is missing next to $(basename "$IMAGE")"
        [[ $(size_of "$src") == "$size" ]] || die "part $name has the wrong size (an incomplete copy or download?)"
        parts+=("$src"); sizes+=("$size"); sums+=("$sum")
        got=$((got + size))
    done <"$idx"
    ((got == whole_size)) || die "the parts of the system image do not add up to its size"

    # One pass over the parts: the SHA-256 of the whole image.
    local sumfile="$dir/whole.sha256"
    cat "${parts[@]}" | sha256sum >"$sumfile" &
    local hpid=$!
    sleep 1
    local catpid
    catpid=$(pgrep -n -x cat || true)
    track "$hpid" "$whole_size" 50 65 "Checking the system image (SHA-256)" read_pos "${catpid:-0}" "${parts[@]}"
    if [[ $(cut -d' ' -f1 "$sumfile") != "$whole_sum" ]]; then
        local i bad=()
        for i in "${!parts[@]}"; do
            [[ $(sha256sum "${parts[$i]}" | cut -d' ' -f1) == "${sums[$i]}" ]] || bad+=("$(basename "${parts[$i]}")")
        done
        die "the system image is damaged (SHA-256 mismatch${bad:+ in ${bad[*]}}); copy or download it again"
    fi
    log "system image checked: $whole_sum"

    # Joined without copying: loop devices over the parts, one linear device-mapper device.
    if command -v dmsetup >/dev/null && ((${#parts[@]} > 1)); then
        local table="" start=0 loopdev secs
        for i in "${!parts[@]}"; do
            loopdev=$(losetup -r -f --show "${parts[$i]}") || { table=""; break; }
            secs=$(( sizes[i] / 512 ))
            table+="$start $secs linear $loopdev 0"$'\n'
            start=$((start + secs))
        done
        if [[ -n $table ]] && printf '%s' "$table" | dmsetup create --readonly totv-image >>"$LOG" 2>&1; then
            echo /dev/mapper/totv-image
            return 0
        fi
        log "device-mapper join failed; merging into one file"
        dmsetup remove totv-image 2>/dev/null || true
        losetup -j "${parts[0]}" >/dev/null 2>&1 && for i in "${!parts[@]}"; do losetup -j "${parts[$i]}" | cut -d: -f1 | xargs -r losetup -d; done
    fi
    if ((${#parts[@]} == 1)); then echo "${parts[0]}"; return 0; fi
    local out="$dir/$whole_name"
    cat "${parts[@]}" >"$out" &
    track $! "$whole_size" 50 65 "Joining the parts of the system image" size_of "$out"
    [[ $IMAGE_KIND == remote ]] && rm -f "${parts[@]}"
    echo "$out"
}

release_image() {
    dmsetup remove totv-image 2>/dev/null || true
    local l
    for l in $(losetup -l -n -O NAME,BACK-FILE 2>/dev/null | awk -v d="$TARGET/.totv-image" 'index($2, d) == 1 {print $1}'); do
        losetup -d "$l" 2>/dev/null || true
    done
}

do_image() {
    local iso mnt=/run/totv-image
    iso=$(fetch_image)
    [[ -n $iso ]] || die "the system image could not be prepared"
    mkdir -p "$mnt"
    if [[ -b $iso ]]; then mount -o ro "$iso" "$mnt"; else mount -o loop,ro "$iso" "$mnt"; fi
    [[ -f $mnt/totv-system/rootfs.sfs ]] || { umount "$mnt"; release_image; die "$(basename "$iso") is not a TotV system image"; }
    log "manifest: $(cat "$mnt/totv-system/manifest.json" 2>/dev/null)"
    local need avail
    need=$(grep -o '"installed_bytes": *[0-9]*' "$mnt/totv-system/manifest.json" 2>/dev/null | grep -o '[0-9]*$' || echo 0)
    avail=$(df -B1 --output=avail "$TARGET" | tail -n1)
    log "space: the system needs $(mib "$need") MiB, $(mib "$avail") MiB free on $DISK"
    if ((need > 0 && avail < need + 1073741824)); then
        umount "$mnt"; release_image
        die "$DISK is too small: TotV needs $(( (need + 1073741824) / 1073741824 )) GiB free to unpack, $(( avail / 1073741824 )) GiB are free (the downloaded image itself takes $(( $(size_of "$iso") / 1073741824 )) GiB until it is unpacked). Use a disk of at least 32 GiB."
    fi
    # Unpacking: unsquashfs -percentage prints one number per line.
    show "Unpacking TotV (the OS, Voices of the Void, r2modman)" 65
    # (Failures are collected with ||, so the installer's ERR trap does not fire mid-way.)
    local status=0 pct
    rm -f /run/totv-unsquashfs.rc
    { rc=0; unsquashfs -percentage -f -d "$TARGET" "$mnt/totv-system/rootfs.sfs" 2>>"$LOG" || rc=$?; echo "rc=$rc"; } |
        while read -r pct; do
            case $pct in
                rc=*) echo "${pct#rc=}" >/run/totv-unsquashfs.rc ;;
                *[!0-9]*|'') ;;
                *) show "Unpacking TotV (the OS, Voices of the Void, r2modman)\n\n$pct% unpacked" $((65 + pct * 34 / 100)) ;;
            esac
        done
    status=$(cat /run/totv-unsquashfs.rc 2>/dev/null || echo 1)
    # Exit status 2: unsquashfs finished with non-fatal errors (e.g. ACLs the live system
    # cannot set); the files are there. Only other statuses are failures.
    if [[ $status == 2 ]]; then
        log "unsquashfs reported non-fatal errors (status 2); continuing"
        status=0
    fi
    # An unsquashfs without -percentage: unpack again without progress.
    if [[ $status != 0 ]] && grep -q -i -e 'unrecognised option' -e 'invalid option' <(tail -n 20 "$LOG"); then
        log "unsquashfs -percentage failed ($status); unpacking without progress"
        show "Unpacking TotV (the OS, Voices of the Void, r2modman)\n\nThis takes several minutes." 70
        status=0
        unsquashfs -f -d "$TARGET" "$mnt/totv-system/rootfs.sfs" >>"$LOG" 2>&1 || status=$?
        [[ $status == 2 ]] && { log "unsquashfs reported non-fatal errors (status 2); continuing"; status=0; }
    fi
    umount "$mnt"
    release_image
    ((status == 0)) || die "unpacking the system image failed (see $LOG)"
    rm -rf "$TARGET/.totv-image"
    mkdir -p "$TARGET"/{proc,sys,dev,run,tmp}
    chmod 1777 "$TARGET/tmp"
    # Keys of this installation: pacman's keyring and the machine id.
    show "Setting up the installation's keys" 99
    in_target systemd-machine-id-setup
    in_target pacman-key --init
    in_target pacman-key --populate archlinux
}

do_install_system() {
    if [[ $SOURCE == image ]]; then do_image; else do_pacstrap; fi
}

do_pacstrap() {
    local pkgs; mapfile -t pkgs < <(target_packages | sort -u)
    log "packages: ${pkgs[*]}"
    pacstrap -C "$PACMAN_CONF" -K "$TARGET" "${pkgs[@]}"
}

in_target() { arch-chroot "$TARGET" "$@"; }

do_system_config() {
    genfstab -U "$TARGET" >>"$TARGET/etc/fstab"
    ln -sf "/usr/share/zoneinfo/$TIMEZONE" "$TARGET/etc/localtime"
    in_target hwclock --systohc || true
    sed -i "s/^#\(${LOCALE//./\\.} \)/\1/" "$TARGET/etc/locale.gen"
    grep -q "^en_US\.UTF-8 " "$TARGET/etc/locale.gen" || sed -i 's/^#\(en_US\.UTF-8 \)/\1/' "$TARGET/etc/locale.gen"
    in_target locale-gen
    echo "LANG=$LOCALE" >"$TARGET/etc/locale.conf"
    echo "KEYMAP=$KEYMAP" >"$TARGET/etc/vconsole.conf"
    echo "$HOSTNAME_" >"$TARGET/etc/hostname"
    cat >"$TARGET/etc/hosts" <<EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   $HOSTNAME_.localdomain $HOSTNAME_
EOF
    # The installed system's pacman: Arch's repositories, multilib (games,
    # Wine) and TotV's own repository (lsiw, totv-base) on GitHub.
    if [[ ! -s $TARGET/etc/pacman.conf ]]; then
        printf '[options]\nHoldPkg = pacman glibc\nArchitecture = auto\nCheckSpace\nParallelDownloads = 5\nSigLevel = Required DatabaseOptional\nLocalFileSigLevel = Optional\n\n[core]\nInclude = /etc/pacman.d/mirrorlist\n\n[extra]\nInclude = /etc/pacman.d/mirrorlist\n' >"$TARGET/etc/pacman.conf"
    fi
    [[ -s $TARGET/etc/pacman.d/mirrorlist ]] || { mkdir -p "$TARGET/etc/pacman.d"; cp /etc/pacman.d/mirrorlist "$TARGET/etc/pacman.d/mirrorlist"; }
    grep -q '^Architecture' "$TARGET/etc/pacman.conf" || sed -i '/^\[options\]/a Architecture = auto' "$TARGET/etc/pacman.conf"
    if ! grep -q '^\[multilib\]' "$TARGET/etc/pacman.conf"; then
        printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >>"$TARGET/etc/pacman.conf"
    fi
    if ! grep -q '^\[totv\]' "$TARGET/etc/pacman.conf"; then
        cat >>"$TARGET/etc/pacman.conf" <<'EOF'

# TotV's own packages (lsiw, totv-base, votv-os), published by each TotV release:
# totv-update keeps the system up to date from here.
[totv]
SigLevel = Optional TrustAll
Server = https://github.com/SoulVoid0/TotV/releases/latest/download
EOF
    fi
    in_target systemctl enable NetworkManager.service systemd-timesyncd.service
}

do_users() {
    in_target systemd-sysusers
    in_target systemd-tmpfiles --create /usr/lib/tmpfiles.d/totv.conf
    in_target useradd -m -G wheel,cdrive,votv -s /bin/bash "$USERNAME"
    in_target usermod -aG gamemode "$USERNAME" 2>/dev/null || true
    printf '%s:%s\n' "$USERNAME" "$USER_PASSWORD" | in_target chpasswd
    if [[ -n $ROOT_PASSWORD ]]; then
        printf 'root:%s\n' "$ROOT_PASSWORD" | in_target chpasswd
    else
        in_target passwd -l root
    fi
    # C:\users\<name> is the user's profile, for every LSIW engine.
    ln -sfn "/home/$USERNAME" "$TARGET/users/$USERNAME"
    ln -sfn "/home/$USERNAME" "$TARGET/users/steamuser"
    in_target chown -h "$USERNAME:cdrive" "/users/$USERNAME" "/users/steamuser"
    # AUTOLOGIN (totv.conf): totvd logs the user in once the shared Home save has loaded.
    :
}

do_totv_config() {
    mkdir -p "$TARGET$CONF/session.d"
    cat >"$TARGET$CONF/totv.conf" <<EOF
# Written by the TotV installer. Read with: totv-config get KEY
TOTV_VERSION=$TOTV_VERSION
TOTV_INSTALL_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ)
HOSTNAME=$HOSTNAME_
AUTOLOGIN=$AUTOLOGIN
OPTIONS='$OPTIONS'
OFFLINE=$OFFLINE
SOURCE=$SOURCE
EOF
    cat >"$TARGET$CONF/user.conf" <<EOF
# The user chosen in the TotV installer. Read with: totv-config username
# SAVE_NAME is the name of the user's own Voices of the Void save (a Home save that
# the game moves to when this user logs in on the in-game PC).
USERNAME=$USERNAME
SAVE_NAME=$USERNAME
EOF
    chmod 0644 "$TARGET$CONF/totv.conf" "$TARGET$CONF/user.conf"
}

do_bootloader() {
    # The TotV initramfs drop-in keeps every driver (no autodetect).
    in_target mkinitcpio -P
    sed -i -e 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="TotV"/' \
           -e 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=2/' "$TARGET/etc/default/grub"
    if [[ -n $KERNEL_CMDLINE ]]; then
        [[ $KERNEL_CMDLINE =~ ^[A-Za-z0-9_.,=:/\ -]+$ ]] || die "KERNEL_CMDLINE has characters that are not allowed"
        sed -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=\"\(.*\)\"|GRUB_CMDLINE_LINUX_DEFAULT=\"\1 $KERNEL_CMDLINE\"|" "$TARGET/etc/default/grub"
    fi
    in_target grub-install --target=i386-pc --recheck "$DISK"
    # --removable: \EFI\BOOT\BOOTX64.EFI, found by every UEFI firmware
    # without a boot entry, so the disk boots on other computers too.
    in_target grub-install --target=x86_64-efi --efi-directory=/boot --removable --recheck
    in_target grub-mkconfig -o /boot/grub/grub.cfg
}

# The Voices of the Void part: in the image it is set up already; from packages, the
# votv-os setup downloads the game, GE-Proton, shimloader and r2modman.
do_votv() {
    if [[ $SOURCE == image ]]; then
        in_target bash -c 'for u in "$@"; do usermod -aG votv "$u"; done' _ "$USERNAME"
        cp -a "$TARGET/etc/skel/Desktop/." "$TARGET/home/$USERNAME/Desktop/" 2>/dev/null || true
        in_target chown -R "$USERNAME:" "/home/$USERNAME"
        [[ -f $TARGET/etc/totv/votv.json ]] || cp "$TARGET/usr/share/votv-os/votv.json" "$TARGET/etc/totv/votv.json"
        return 0
    fi
    TOTV_USERNAME="$USERNAME" VOTV_SKIP_PACKAGES=1 VOTV_FETCH=1 TOTV_GAME_ARCHIVE="$GAME_ARCHIVE" \
        in_target bash /usr/share/votv-os/host/install.sh /
}

do_finish() {
    cp "$LOG" "$TARGET/var/log/totv-install.log" 2>/dev/null || true
    sync
    umount -R "$TARGET"
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
load_answers() {
    local f=$1 k v
    [[ -r $f ]] || die "cannot read $f"
    while IFS='=' read -r k v; do
        [[ -z $k || $k == \#* ]] && continue
        v=${v#\"}; v=${v%\"}; v=${v#\'}; v=${v%\'}
        case $k in
            DISK) DISK=$v ;; HOSTNAME) HOSTNAME_=$v ;; USERNAME) USERNAME=$v ;;
            USER_PASSWORD) USER_PASSWORD=$v ;; ROOT_PASSWORD) ROOT_PASSWORD=$v ;;
            TIMEZONE) TIMEZONE=$v ;; LOCALE) LOCALE=$v ;; KEYMAP) KEYMAP=$v ;;
            AUTOLOGIN) AUTOLOGIN=$v ;; OPTIONS) OPTIONS=$v ;; GAME_ARCHIVE) GAME_ARCHIVE=$v ;;
            SOURCE) SOURCE=$v ;; IMAGE) IMAGE=$v ;; IMAGE_URL) IMAGE_URL=$v ;;
            CONFIRM_WIPE) CONFIRM_WIPE=$v ;; REBOOT) REBOOT=$v ;; KERNEL_CMDLINE) KERNEL_CMDLINE=$v ;;
            *) die "unknown key '$k' in $f" ;;
        esac
    done <"$f"
    [[ -b $DISK ]] || die "DISK=$DISK is not a block device"
    [[ $DISK != "$(live_disk)" ]] || die "DISK=$DISK is the installer's own disk"
    valid_username "$USERNAME" || die "USERNAME='$USERNAME' is not a valid username"
    [[ -n $USER_PASSWORD ]] || die "USER_PASSWORD is empty"
    valid_hostname "${HOSTNAME_:=totv}" || die "HOSTNAME='$HOSTNAME_' is not valid"
    valid_timezone "$TIMEZONE" || die "TIMEZONE='$TIMEZONE' is not a time zone"
    valid_locale "$LOCALE" || die "LOCALE='$LOCALE' is not a supported locale"
    valid_keymap "$KEYMAP" || die "KEYMAP='$KEYMAP' is not a keyboard layout"
    [[ $AUTOLOGIN == yes || $AUTOLOGIN == no ]] || die "AUTOLOGIN must be yes or no"
    [[ $CONFIRM_WIPE == yes ]] || die "set CONFIRM_WIPE=yes to erase $DISK"
    [[ $SOURCE == auto || $SOURCE == image || $SOURCE == packages ]] || die "SOURCE must be auto, image or packages"
    [[ -z $IMAGE || -r $IMAGE ]] || die "IMAGE=$IMAGE cannot be read"
}

main() {
    case ${1:-} in
        -h|--help) sed -n '2,21s/^# \{0,1\}//p' "$0"; exit 0 ;;
        --answers) [[ $# -eq 2 ]] || die "usage: totv-install --answers FILE"; INTERACTIVE=0 ;;
        '') ;;
        *) echo "usage: totv-install [--answers FILE]" >&2; exit 2 ;;
    esac
    ((EUID == 0)) || { echo "totv-install must run as root" >&2; exit 1; }
    : >"$LOG"
    log "TotV installer $TOTV_VERSION"

    if ((INTERACTIVE)); then
        command -v dialog >/dev/null || die "dialog is missing"
        dialog --backtitle "$TITLE" --title "Welcome" --yes-label "Install" --no-label "Shell" --yesno \
"Welcome to TotV, an operating system based on Arch Linux that lives
inside Voices of the Void.

This installer sets TotV up (your username, password, language and time
zone) and installs it on a disk or USB stick of your choice, from the
TotV system image (found on a drive, or downloaded and merged).

Choose Shell to leave the installer; type totv-install to start it again." 14 76 || { clear; exit 0; }
        ask_keymap
        pick_disk
        pick_sources
        ask_username
        ask_password "$USERNAME"; USER_PASSWORD=$REPLY_PW
        ask_password root empty-ok; ROOT_PASSWORD=$REPLY_PW
        ask_hostname
        ask_timezone
        ask_locale
        ask_options
        confirm || { clear; echo "Nothing was changed. Type totv-install to start again."; exit 0; }
    else
        load_answers "$2"
        pick_sources
    fi
    log "disk=$DISK user=$USERNAME host=$HOSTNAME_ tz=$TIMEZONE locale=$LOCALE keymap=$KEYMAP autologin=$AUTOLOGIN options='$OPTIONS' offline=$OFFLINE"

    step "Preparing $DISK" do_cleanup_target
    step "Partitioning $DISK" do_partition
    step "Formatting" do_format
    step "Mounting" do_mount
    step "Installing the system: $(describe_source) (this takes a while)" do_install_system
    step "Configuring the system" do_system_config
    step "Creating user $USERNAME" do_users
    step "Writing /etc/totv" do_totv_config
    step "Installing the bootloader" do_bootloader
    step "Setting up Voices of the Void" do_votv
    step "Finishing" do_finish
    STEP_NO=$((STEP_TOTAL - 1))
    step "Done" true

    if ((INTERACTIVE)); then
        if dialog --backtitle "$TITLE" --title "TotV is installed" --yes-label "Reboot" --no-label "Shell" --yesno \
            "TotV is installed on $DISK.\n\nRemove the installer USB stick and reboot. TotV starts in the shared Home save; log in as $USERNAME on the in-game PC to go to your own save." 10 64; then
            reboot
        fi
        clear
    else
        echo "TotV is installed on $DISK."
        if [[ $REBOOT == yes ]]; then reboot; fi
    fi
}

main "$@"
